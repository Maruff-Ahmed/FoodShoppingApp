@model List<FoodShoppingApp.Models.Order>

@{
    ViewData["Title"] = "My Grocery Orders";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">My Orders</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold mb-1">📦 My Orders</h1>
            <p class="text-muted small mb-0">Track your current food shipments and view past receipts</p>
        </div>
        <a asp-controller="Shop" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-bold">
            <i class="bi bi-cart-plus me-1"></i> Place New Order
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 rounded-4 shadow-sm text-center py-5 my-4" style="background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
            <div class="card-body py-5">
                <div class="display-2 mb-3">📦</div>
                <h3 class="fw-bold">No orders placed yet</h3>
                <p class="text-muted mb-4">You haven't ordered any fresh groceries or meals yet.</p>
                <a class="btn btn-primary rounded-pill px-5 fw-bold" asp-controller="Shop" asp-action="Index">
                    Browse Grocery Market
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 rounded-4 shadow-sm overflow-hidden" style="background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light border-bottom">
                        <tr>
                            <th class="ps-4 py-3">Order Ref</th>
                            <th class="py-3">Order Date</th>
                            <th class="text-center py-3">Status</th>
                            <th class="py-3">Payment</th>
                            <th class="text-end py-3">Total Amount</th>
                            <th class="text-end pe-4 py-3">Receipt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            var badgeClass = order.Status switch
                            {
                                "Pending" => "bg-warning text-dark",
                                "Processing" => "bg-info text-dark",
                                "Delivered" => "bg-success text-white",
                                "Cancelled" => "bg-danger text-white",
                                _ => "bg-secondary text-white"
                            };

                            <tr>
                                <td class="ps-4 py-3 fw-bold text-dark">
                                    #@order.Id
                                </td>
                                <td class="py-3 text-muted small">
                                    @order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")
                                </td>
                                <td class="text-center py-3">
                                    <span class="badge @badgeClass rounded-pill px-3 py-1">
                                        @order.Status
                                    </span>
                                </td>
                                <td class="py-3 small text-dark">
                                    @order.PaymentMethod
                                </td>
                                <td class="text-end py-3 fw-bold text-success">
                                    ৳ @order.TotalAmount.ToString("0.00")
                                </td>
                                <td class="text-end pe-4 py-3">
                                    <a asp-action="Invoice" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        <i class="bi bi-receipt"></i> Invoice
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
