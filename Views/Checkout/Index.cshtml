@model FoodShoppingApp.Models.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<div class="container py-4">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-white py-3">
                    <h4 class="mb-0 fw-bold">Order Summary</h4>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Product</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end">Price</th>
                                    <th class="text-end pe-3">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.CartItems)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <div class="fw-semibold">@item.Product.Name</div>
                                            <small class="text-muted">@item.Product.Category?.Name</small>
                                        </td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end">৳ @item.Product.Price.ToString("0.00")</td>
                                        <td class="text-end pe-3 fw-semibold">৳ @((item.Product.Price * item.Quantity).ToString("0.00"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- PAYMENT METHOD -->
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">Payment Method</h5>
                </div>
                <div class="card-body">
                    <div class="form-check p-3 border rounded-3 bg-light">
                        <input class="form-check-input" type="radio" name="paymentMethodChoice" id="cod" checked disabled />
                        <label class="form-check-label fw-semibold" for="cod">
                            💵 Cash On Delivery (COD)
                        </label>
                        <p class="text-muted small mb-0 mt-1">Pay with cash upon delivery of your food order.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-3 mb-3">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">Apply Discount Code</h5>
                </div>
                <div class="card-body">
                    @if (ViewBag.DiscountError != null)
                    {
                        <div class="alert alert-danger py-2 small" role="alert">
                            @ViewBag.DiscountError
                        </div>
                    }
                    @if (ViewBag.DiscountSuccess != null)
                    {
                        <div class="alert alert-success py-2 small" role="alert">
                            @ViewBag.DiscountSuccess
                        </div>
                    }

                    <form asp-action="ApplyDiscount" method="post">
                        @Html.AntiForgeryToken()
                        <div class="input-group">
                            <input asp-for="DiscountCode" class="form-control" placeholder="Promo code (e.g. SAVE10)" />
                            <button type="submit" class="btn btn-outline-primary">Apply</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">Total Payable</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal:</span>
                        <span class="fw-semibold">৳ @Model.SubTotal.ToString("0.00")</span>
                    </div>

                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 text-success">
                            <span>Discount (@Model.DiscountCode):</span>
                            <span>- ৳ @Model.DiscountAmount.ToString("0.00")</span>
                        </div>
                    }

                    <hr />

                    <div class="d-flex justify-content-between mb-4">
                        <span class="fs-5 fw-bold">Grand Total:</span>
                        <span class="fs-5 fw-bold text-danger">৳ @Model.FinalTotal.ToString("0.00")</span>
                    </div>

                    <!-- PLACE ORDER (COD) -->
                    <form asp-action="PlaceOrder" method="post" id="placeOrderForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="DiscountCode" />
                        <input type="hidden" asp-for="CheckoutToken" />

                        <button type="submit" id="placeOrderBtn" class="btn btn-success btn-lg w-100 py-3 fw-bold">
                            Place Order (Cash On Delivery)
                        </button>
                    </form>
                    <a asp-controller="Cart" asp-action="Index" class="btn btn-link w-100 text-center text-muted mt-2">
                        Modify Cart
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('placeOrderForm')?.addEventListener('submit', function () {
            var btn = document.getElementById('placeOrderBtn');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Processing Order...';
            }
        });
    </script>
}
