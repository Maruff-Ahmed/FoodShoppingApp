@model FoodShoppingApp.Models.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Secure Checkout";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Cart" asp-action="Index" class="text-decoration-none">Cart</a></li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Checkout</li>
        </ol>
    </nav>

    <!-- Checkout Steps Visual Header -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-2 border-bottom">
        <div>
            <h1 class="display-6 fw-bold mb-1">Secure Checkout</h1>
            <p class="text-muted small mb-0">Provide delivery preferences & confirm your order</p>
        </div>
        <div class="d-none d-md-flex align-items-center gap-2 small">
            <span class="badge bg-success rounded-pill px-3 py-2">✓ 1. Cart Reviewed</span>
            <span class="text-muted">→</span>
            <span class="badge bg-primary rounded-pill px-3 py-2">● 2. Delivery & Payment</span>
            <span class="text-muted">→</span>
            <span class="badge bg-light text-muted border rounded-pill px-3 py-2">3. Receipt</span>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-4 shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Left: Items & Delivery Details -->
        <div class="col-lg-8">
            <!-- Order Line Items -->
            <div class="card border-0 rounded-4 shadow-sm mb-4" style="background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold">1. Order Review (@Model.CartItems.Sum(c => c.Quantity) Items)</h5>
                    <a asp-controller="Cart" asp-action="Index" class="small text-success text-decoration-none fw-semibold">
                        Edit Basket
                    </a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4 py-2" style="width: 50%;">Grocery Item</th>
                                    <th class="text-center py-2" style="width: 15%;">Qty</th>
                                    <th class="text-end py-2" style="width: 15%;">Price</th>
                                    <th class="text-end pe-4 py-2" style="width: 20%;">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.CartItems)
                                {
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <div class="fw-bold text-dark">@item.Product.Name</div>
                                            <small class="text-muted">@(item.Product.Category?.Name ?? "Food")</small>
                                        </td>
                                        <td class="text-center py-3 fw-bold">@item.Quantity</td>
                                        <td class="text-end py-3 text-muted">৳ @item.Product.Price.ToString("0.00")</td>
                                        <td class="text-end pe-4 py-3 fw-bold text-dark">৳ @((item.Product.Price * item.Quantity).ToString("0.00"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Delivery Address Form Mockup -->
            <div class="card border-0 rounded-4 shadow-sm mb-4" style="background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 fw-bold">2. Delivery Address</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">Recipient Name</label>
                            <input type="text" class="form-control rounded-3" value="@(User.Identity?.Name?.Split('@')[0] ?? "Customer")" readonly />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark">Contact Phone</label>
                            <input type="tel" class="form-control rounded-3" placeholder="+880 1700-000000" value="+880 1712-345678" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-dark">Delivery Street Address</label>
                            <input type="text" class="form-control rounded-3" placeholder="House / Flat No., Road Name, Area" value="House 42, Road 11, Sector 4, Mirpur, Dhaka" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-bold text-dark">Delivery Notes (Optional)</label>
                            <input type="text" class="form-control rounded-3" placeholder="e.g. Please leave at front door, call upon arrival" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payment Method Card -->
            <div class="card border-0 rounded-4 shadow-sm" style="background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 fw-bold">3. Payment Option</h5>
                </div>
                <div class="card-body p-4">
                    <div class="p-3 border border-success rounded-4 bg-success bg-opacity-10 d-flex align-items-center justify-content-between">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-success text-white p-2 fs-4">💵</div>
                            <div>
                                <h6 class="fw-bold mb-0 text-success">Cash On Delivery (COD)</h6>
                                <small class="text-muted">Inspect produce upon arrival and pay cash directly to courier.</small>
                            </div>
                        </div>
                        <span class="badge bg-success rounded-pill px-3 py-2">Selected</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Summary & Promo Code -->
        <div class="col-lg-4">
            <!-- Apply Discount Code Card -->
            <div class="card border-0 rounded-4 shadow-sm mb-4" style="background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 fw-bold">Promotional Discount</h5>
                </div>
                <div class="card-body p-4">
                    @if (ViewBag.DiscountError != null)
                    {
                        <div class="alert alert-danger py-2 small rounded-3" role="alert">
                            <i class="bi bi-x-circle me-1"></i> @ViewBag.DiscountError
                        </div>
                    }
                    @if (ViewBag.DiscountSuccess != null)
                    {
                        <div class="alert alert-success py-2 small rounded-3" role="alert">
                            <i class="bi bi-check-circle me-1"></i> @ViewBag.DiscountSuccess
                        </div>
                    }

                    <form asp-action="ApplyDiscount" method="post">
                        @Html.AntiForgeryToken()
                        <div class="input-group">
                            <input asp-for="DiscountCode" class="form-control rounded-start-pill" placeholder="Promo code (e.g. SAVE10)" />
                            <button type="submit" class="btn btn-primary rounded-end-pill px-3 fw-bold">Apply</button>
                        </div>
                    </form>
                    <small class="text-muted d-block mt-2">Available codes: <strong>SAVE10</strong> (10% off), <strong>FRESH20</strong> (20% off)</small>
                </div>
            </div>

            <!-- Billing Breakdown Card -->
            <div class="card border-0 rounded-4 shadow-sm p-4" style="background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
                <h5 class="fw-bold mb-3">Order Total</h5>

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Items Subtotal:</span>
                    <span class="fw-bold">৳ @Model.SubTotal.ToString("0.00")</span>
                </div>

                @if (Model.DiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between mb-2 text-success">
                        <span>Coupon (@Model.DiscountCode):</span>
                        <span class="fw-bold">- ৳ @Model.DiscountAmount.ToString("0.00")</span>
                    </div>
                }

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Express Delivery:</span>
                    <span class="text-success fw-bold">FREE</span>
                </div>

                <hr class="my-3">

                <div class="d-flex justify-content-between align-items-baseline mb-4">
                    <span class="fs-5 fw-bold text-dark">Payable Amount:</span>
                    <span class="fs-3 fw-bold text-success">৳ @Model.FinalTotal.ToString("0.00")</span>
                </div>

                <!-- Place Order Form -->
                <form asp-action="PlaceOrder" method="post" id="placeOrderForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="DiscountCode" />
                    <input type="hidden" asp-for="CheckoutToken" />

                    <button type="submit" id="placeOrderBtn" class="btn btn-primary btn-lg w-100 py-3 fw-bold rounded-pill shadow-sm d-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-shield-check"></i>
                        <span>Confirm Order (Cash on Delivery)</span>
                    </button>
                </form>

                <div class="text-center mt-3">
                    <small class="text-muted">
                        <i class="bi bi-lock-fill text-success"></i> 256-Bit SSL Secured Checkout
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('placeOrderForm')?.addEventListener('submit', function (e) {
            var form = this;
            if (form.dataset.submitting === 'true') {
                e.preventDefault();
                return false;
            }
            form.dataset.submitting = 'true';
            var btn = document.getElementById('placeOrderBtn');
            if (btn) {
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Processing Order...';
                setTimeout(function () {
                    btn.disabled = true;
                }, 50);
            }
        });
    </script>
}
