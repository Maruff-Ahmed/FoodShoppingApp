@model FoodShoppingApp.Models.Order

@{
    ViewData["Title"] = $"Invoice - Order #{Model.Id}";

    var badgeClass = Model.Status switch
    {
        "Pending" => "bg-warning text-dark",
        "Processing" => "bg-info text-dark",
        "Delivered" => "bg-success text-white",
        "Cancelled" => "bg-danger text-white",
        _ => "bg-secondary text-white"
    };

    var subtotal = Model.TotalAmount + Model.DiscountAmount;
}

<div class="container py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 d-print-none rounded-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 rounded-4 shadow-sm p-4 p-md-5 bg-white mb-4" style="border: 1px solid #E2E8F0 !important;">
        <!-- INVOICE TOP BAR -->
        <div class="d-flex flex-wrap justify-content-between align-items-start border-bottom pb-4 mb-4 gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="brand-logo-icon" style="width: 50px; height: 50px; font-size: 1.6rem;">
                    🥬
                </div>
                <div>
                    <h3 class="fw-bold mb-0 text-dark">Urban Fresh Market</h3>
                    <small class="text-muted">Customer Order Receipt & Statement • Support: 01888929292</small>
                </div>
            </div>
            <div class="text-md-end">
                <span class="badge @badgeClass px-3 py-2 rounded-pill mb-2">@Model.Status</span>
                <div class="text-dark fw-bold fs-5">Invoice #@Model.Id</div>
                <small class="text-muted">Date: @Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</small>
            </div>
        </div>

        <!-- DETAILS ROW -->
        <div class="row g-3 mb-4 p-3 bg-light rounded-4">
            <div class="col-sm-6">
                <span class="text-muted small text-uppercase fw-bold">Customer Account:</span>
                <div class="fw-bold text-dark mt-1">@(Model.User?.Email ?? "Customer Account")</div>
                <small class="text-muted">Payment: <strong class="text-dark">@Model.PaymentMethod</strong></small>
            </div>
            <div class="col-sm-6 text-sm-end">
                <span class="text-muted small text-uppercase fw-bold">Delivery Address:</span>
                <div class="fw-bold text-dark mt-1">Mirpur Section 10, Dhaka</div>
                <small class="text-success fw-bold"><i class="bi bi-truck"></i> 15-30 Mins Express Delivery</small>
            </div>
        </div>

        <!-- TABLE OF ITEMS -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3 py-2" style="width: 50%;">Grocery Item</th>
                        <th class="text-center py-2" style="width: 15%;">Quantity</th>
                        <th class="text-end py-2" style="width: 15%;">Unit Price</th>
                        <th class="text-end pe-3 py-2" style="width: 20%;">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderItems)
                    {
                        <tr>
                            <td class="ps-3 py-3">
                                <div class="fw-bold text-dark">@(item.Product?.Name ?? "Grocery Product")</div>
                                <small class="text-muted">@(item.Product?.Category?.Name ?? "Fresh Produce")</small>
                            </td>
                            <td class="text-center py-3 fw-bold">@item.Quantity</td>
                            <td class="text-end py-3 text-muted">৳ @item.Price.ToString("0.00")</td>
                            <td class="text-end pe-3 py-3 fw-bold text-dark">৳ @((item.Price * item.Quantity).ToString("0.00"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- TOTALS BREAKDOWN -->
        <div class="row justify-content-end mb-4">
            <div class="col-md-5">
                <div class="card border-0 bg-light p-3 rounded-4">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal:</span>
                        <span class="fw-bold">৳ @subtotal.ToString("0.00")</span>
                    </div>

                    @if (Model.DiscountAmount > 0)
                    {
                        <div class="d-flex justify-content-between mb-2 text-success">
                            <span>Promo Discount (@Model.DiscountCode):</span>
                            <span class="fw-bold">- ৳ @Model.DiscountAmount.ToString("0.00")</span>
                        </div>
                    }

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Delivery Fee:</span>
                        <span class="text-success fw-bold">FREE</span>
                    </div>

                    <hr class="my-2">

                    <div class="d-flex justify-content-between align-items-baseline">
                        <span class="fs-5 fw-bold text-dark">Final Payable:</span>
                        <span class="fs-4 fw-bold text-success">৳ @Model.TotalAmount.ToString("0.00")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- PRINT AND BACK BUTTONS -->
        <div class="d-flex justify-content-between align-items-center d-print-none pt-3 border-top">
            <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="bi bi-arrow-left me-1"></i> Return to Store
            </a>
            <div class="d-flex gap-2">
                <a asp-controller="Checkout" asp-action="MyOrders" class="btn btn-light border rounded-pill px-4">
                    My Orders
                </a>
                <button onclick="window.print();" class="btn btn-primary rounded-pill px-4 fw-bold">
                    <i class="bi bi-printer me-1"></i> Print Receipt
                </button>
            </div>
        </div>
    </div>
</div>
