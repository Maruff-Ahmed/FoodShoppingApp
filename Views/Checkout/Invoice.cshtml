@model FoodShoppingApp.Models.Order

@{
    ViewData["Title"] = $"Invoice - Order #{Model.Id}";

    var badgeClass = Model.Status switch
    {
        "Pending" => "bg-warning text-dark",
        "Processing" => "bg-info text-dark",
        "Delivered" => "bg-success text-white",
        "Cancelled" => "bg-danger text-white",
        _ => "bg-secondary text-white"
    };
}

<div class="container py-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 d-print-none" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3 p-4 p-md-5 bg-white">
        <!-- INVOICE HEADER -->
        <div class="d-flex justify-content-between align-items-start border-bottom pb-4 mb-4">
            <div>
                <h2 class="fw-bold text-danger mb-1">🍔 FoodShoppingApp</h2>
                <p class="text-muted small mb-0">Official Customer Order Receipt & Billing Statement</p>
            </div>
            <div class="text-end">
                <h4 class="fw-bold mb-1">INVOICE</h4>
                <div class="text-muted small">Order Reference: <strong class="text-dark">#@Model.Id</strong></div>
                <div class="text-muted small">Issued Date: @Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</div>
            </div>
        </div>

        <!-- DETAILS ROW -->
        <div class="row g-3 mb-4">
            <div class="col-sm-6">
                <span class="text-muted small text-uppercase fw-semibold">Billed To:</span>
                <div class="fw-bold mt-1">@(Model.User?.Email ?? "Customer Account")</div>
                <div class="text-muted small">Payment: <strong class="text-dark">@Model.PaymentMethod</strong></div>
            </div>
            <div class="col-sm-6 text-sm-end">
                <span class="text-muted small text-uppercase fw-semibold">Order Status:</span>
                <div class="mt-1">
                    <span class="badge @badgeClass px-3 py-2">@Model.Status</span>
                </div>
            </div>
        </div>

        <!-- TABLE -->
        <div class="table-responsive mb-4">
            <table class="table table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3" style="width: 50%;">Item Description</th>
                        <th class="text-center" style="width: 15%;">Quantity</th>
                        <th class="text-end" style="width: 15%;">Unit Price</th>
                        <th class="text-end pe-3" style="width: 20%;">Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.OrderItems)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold">
                                @(item.Product?.Name ?? $"Item #{item.ProductId}")
                            </td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end">৳ @item.Price.ToString("0.00")</td>
                            <td class="text-end pe-3 fw-semibold">৳ @((item.Price * item.Quantity).ToString("0.00"))</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- SUMMARY -->
        <div class="row justify-content-end mb-4">
            <div class="col-md-5">
                <div class="card bg-light border-0 p-3">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal:</span>
                        <span class="fw-semibold">৳ @Model.OrderItems.Sum(i => i.Price * i.Quantity).ToString("0.00")</span>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.DiscountCode))
                    {
                        <div class="d-flex justify-content-between mb-2 text-success">
                            <span>Promo Discount (@Model.DiscountCode):</span>
                            <span>- ৳ @Model.DiscountAmount.ToString("0.00")</span>
                        </div>
                    }

                    <hr class="my-2" />

                    <div class="d-flex justify-content-between">
                        <span class="fs-5 fw-bold">Total Payable:</span>
                        <span class="fs-5 fw-bold text-danger">৳ @Model.TotalAmount.ToString("0.00")</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-top pt-4 text-center text-muted small">
            Thank you for shopping with FoodShoppingApp! For support, contact support@foodshoppingapp.com.
        </div>
    </div>

    <!-- ACTIONS -->
    <div class="d-flex justify-content-between mt-4 d-print-none">
        <a asp-action="MyOrders" class="btn btn-outline-secondary rounded-pill px-4">
            ← View My Orders
        </a>
        <div class="d-flex gap-2">
            <a asp-controller="Shop" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                Continue Shopping
            </a>
            <button onclick="window.print()" class="btn btn-dark rounded-pill px-4">
                🖨️ Print Receipt
            </button>
        </div>
    </div>
</div>

<style>
    @@media print {
        .navbar, footer, .d-print-none {
            display: none !important;
        }
        body {
            background-color: #fff !important;
            margin: 0;
            padding: 0;
        }
        .container {
            max-width: 100% !important;
            width: 100% !important;
            padding: 0 !important;
        }
        .card {
            box-shadow: none !important;
            border: none !important;
        }
    }
</style>
