@model List<FoodShoppingApp.Models.CartItem>

@{
    ViewData["Title"] = "Your Shopping Cart";
    decimal grandTotal = 0;
    foreach (var item in Model)
    {
        grandTotal += item.Product.Price * item.Quantity;
    }
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index" class="text-decoration-none">Grocery Shop</a></li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Shopping Cart</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold mb-1">🛒 Shopping Cart</h1>
            <p class="text-muted small mb-0">Review your selected fresh produce and food items</p>
        </div>
        @if (Model.Any())
        {
            <form asp-action="Clear" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('Clear all items from your cart?');">
                    <i class="bi bi-trash"></i> Clear All
                </button>
            </form>
        }
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4 rounded-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 rounded-4 shadow-sm text-center py-5 my-4" style="background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
            <div class="card-body py-5">
                <div class="display-1 mb-3">🛒</div>
                <h3 class="fw-bold">Your shopping cart is empty</h3>
                <p class="text-muted mb-4">You haven't added any fresh groceries or foods to your basket yet.</p>
                <a class="btn btn-primary btn-lg rounded-pill px-5 fw-bold" asp-controller="Shop" asp-action="Index">
                    <i class="bi bi-bag-plus me-1"></i> Start Shopping
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Left: Cart Items Table -->
            <div class="col-lg-8">
                <div class="card border-0 rounded-4 shadow-sm overflow-hidden" style="background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
                    <div class="table-responsive">
                        <table class="table align-middle table-hover mb-0">
                            <thead class="table-light border-bottom">
                                <tr>
                                    <th class="ps-4 py-3" style="width: 45%;">Product</th>
                                    <th class="text-center py-3" style="width: 15%;">Unit Price</th>
                                    <th class="text-center py-3" style="width: 20%;">Quantity</th>
                                    <th class="text-end py-3" style="width: 15%;">Subtotal</th>
                                    <th class="text-center pe-4 py-3" style="width: 5%;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    var lineTotal = item.Product.Price * item.Quantity;
                                    <tr>
                                        <!-- Product info -->
                                        <td class="ps-4 py-3">
                                            <div class="d-flex align-items-center">
                                                <img src="@item.Product.ImageUrl" alt="@item.Product.Name"
                                                     class="rounded-3 me-3 p-1 border bg-light"
                                                     style="width: 60px; height: 60px; object-fit: contain;"
                                                     onerror="this.src='/images/tomato.svg';" />
                                                <div>
                                                    <h6 class="mb-0 fw-bold">
                                                        <a asp-controller="Shop" asp-action="Details" asp-route-id="@item.Product.Id" class="text-dark text-decoration-none">
                                                            @item.Product.Name
                                                        </a>
                                                    </h6>
                                                    <span class="badge bg-light text-muted border small mt-1">
                                                        @(item.Product.Category?.Name ?? "Item")
                                                    </span>
                                                </div>
                                            </div>
                                        </td>

                                        <!-- Unit Price -->
                                        <td class="text-center py-3 fw-semibold">
                                            ৳ @item.Product.Price.ToString("0.00")
                                        </td>

                                        <!-- Quantity Stepper -->
                                        <td class="text-center py-3">
                                            <div class="d-inline-flex align-items-center bg-light border rounded-pill p-1">
                                                <!-- Decrement -->
                                                <form asp-action="UpdateQuantity" method="post" class="d-inline m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="productId" value="@item.Product.Id" />
                                                    <input type="hidden" name="quantity" value="@(item.Quantity - 1)" />
                                                    <button type="submit" class="btn btn-sm btn-white rounded-circle shadow-none p-0 text-dark"
                                                            style="width: 26px; height: 26px; line-height: 1;" title="Decrease">−</button>
                                                </form>

                                                <span class="mx-3 fw-bold text-dark">@item.Quantity</span>

                                                <!-- Increment -->
                                                <form asp-action="UpdateQuantity" method="post" class="d-inline m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="productId" value="@item.Product.Id" />
                                                    <input type="hidden" name="quantity" value="@(item.Quantity + 1)" />
                                                    <button type="submit" class="btn btn-sm btn-white rounded-circle shadow-none p-0 text-dark"
                                                            style="width: 26px; height: 26px; line-height: 1;" title="Increase">+</button>
                                                </form>
                                            </div>
                                        </td>

                                        <!-- Line Total -->
                                        <td class="text-end py-3 fw-bold text-success">
                                            ৳ @lineTotal.ToString("0.00")
                                        </td>

                                        <!-- Remove Item -->
                                        <td class="text-center pe-4 py-3">
                                            <form asp-action="Remove" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="productId" value="@item.Product.Id" />
                                                <button type="submit" class="btn btn-sm btn-light text-danger rounded-circle p-1" title="Remove item">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Shopping reassurance strip -->
                <div class="d-flex justify-content-between align-items-center mt-3 px-2">
                    <a asp-controller="Shop" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-1"></i> Continue Shopping
                    </a>
                    <span class="text-muted small">
                        <i class="bi bi-shield-check text-success me-1"></i> Safe & Contactless Packaging
                    </span>
                </div>
            </div>

            <!-- Right: Order Summary -->
            <div class="col-lg-4">
                <div class="card border-0 rounded-4 shadow-sm p-4" style="background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
                    <h5 class="fw-bold mb-3">Order Summary</h5>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal:</span>
                        <span class="fw-bold">৳ @grandTotal.ToString("0.00")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Estimated Delivery:</span>
                        @if (grandTotal >= 500)
                        {
                            <span class="text-success fw-bold">FREE</span>
                        }
                        else
                        {
                            <span class="text-dark fw-semibold">৳ 50.00</span>
                        }
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Payment Method:</span>
                        <span class="text-dark fw-semibold">Cash On Delivery</span>
                    </div>

                    <hr class="my-3">

                    <div class="d-flex justify-content-between align-items-baseline mb-4">
                        <span class="fs-5 fw-bold">Total:</span>
                        <span class="fs-4 fw-bold text-success">
                            ৳ @((grandTotal >= 500 ? grandTotal : grandTotal + 50).ToString("0.00"))
                        </span>
                    </div>

                    <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary btn-lg rounded-pill w-100 py-3 fw-bold mb-3 d-flex align-items-center justify-content-center gap-2">
                        <span>Proceed to Checkout</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>

                    <!-- Coupon Tip -->
                    <div class="p-3 bg-light rounded-3 border small">
                        <i class="bi bi-tag-fill text-warning me-1"></i>
                        Have a promo code? Apply <strong>SAVE10</strong> for 10% OFF at checkout!
                    </div>
                </div>
            </div>
        </div>
    }
</div>
