@model IEnumerable<FoodShoppingApp.Models.Category>

@{
    ViewData["Title"] = "Store Category Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="display-6 fw-bold mb-1">📁 Store Aisles & Categories</h1>
            <p class="text-muted small mb-0">Organize food products into natural grocery categories</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-bold">
                <i class="bi bi-plus-lg me-1"></i> Add New Category
            </a>
            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-3">
                ← Dashboard
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4" role="alert">
            <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 rounded-4 shadow-sm overflow-hidden" style="background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="ps-4 py-3" style="width: 15%;">ID</th>
                        <th class="py-3" style="width: 50%;">Category / Aisle Name</th>
                        <th class="text-center py-3" style="width: 15%;">Active Products</th>
                        <th class="text-end pe-4 py-3" style="width: 20%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                No categories created yet. Click "+ Add New Category" to begin.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var cat in Model)
                        {
                            <tr>
                                <td class="ps-4 py-3 text-muted">#@cat.Id</td>
                                <td class="py-3 fw-bold text-dark fs-6">
                                    @cat.Name
                                </td>
                                <td class="text-center py-3">
                                    <span class="badge bg-success bg-opacity-15 text-success rounded-pill px-3 py-1">
                                        @(cat.Products?.Count ?? 0) Items
                                    </span>
                                </td>
                                <td class="text-end pe-4 py-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@cat.Id" class="btn btn-outline-secondary rounded-start-pill px-3" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@cat.Id" class="btn btn-outline-danger rounded-end-pill px-3" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
