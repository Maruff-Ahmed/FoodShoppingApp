@model IEnumerable<FoodShoppingApp.Models.Category>

@{
    ViewData["Title"] = "Category Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Category Management</h2>
            <p class="text-muted small mb-0">Organize and manage food menu categories</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                + Add New Category
            </a>
            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary ms-2">
                ← Dashboard
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3" style="width: 15%;">ID</th>
                            <th style="width: 50%;">Category Name</th>
                            <th class="text-center" style="width: 15%;">Products Count</th>
                            <th class="text-end pe-3" style="width: 20%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    No categories found. Click "Add New Category" to create one.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-muted">#@item.Id</td>
                                    <td class="fw-semibold">@item.Name</td>
                                    <td class="text-center">
                                        <span class="badge bg-secondary rounded-pill">
                                            @(item.Products?.Count ?? 0)
                                        </span>
                                    </td>
                                    <td class="text-end pe-3">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
