@model FoodShoppingApp.Models.Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4">
                    <h3 class="fw-bold text-danger mb-3">Delete Category</h3>

                    @if (ViewBag.HasProducts == true)
                    {
                        <div class="alert alert-danger" role="alert">
                            <strong>Warning:</strong> This category contains active products. You must reassign or delete those products before this category can be removed.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning" role="alert">
                            Are you sure you want to permanently delete this category?
                        </div>
                    }

                    <div class="mb-4">
                        <label class="text-muted small">Category Name</label>
                        <h4 class="fw-bold">@Model.Name</h4>
                    </div>

                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex gap-2">
                            @if (ViewBag.HasProducts == true)
                            {
                                <button type="submit" class="btn btn-danger px-4" disabled>Delete Category</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-danger px-4">Confirm Delete</button>
                            }
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
