@model FoodShoppingApp.Models.CustomerRegisterViewModel

@{
    ViewData["Title"] = "Create Urban Fresh Account";
}

<div class="row justify-content-center py-5">
    <div class="col-md-5 col-lg-4">
        <div class="card border-0 rounded-4 shadow-sm p-4" style="background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
            <div class="card-body p-2">
                <!-- Brand icon -->
                <div class="text-center mb-4">
                    <div class="brand-logo-icon mx-auto mb-2" style="width: 52px; height: 52px; font-size: 1.8rem;">
                        🥬
                    </div>
                    <h3 class="card-title fw-bold mb-1">Join Urban Fresh</h3>
                    <p class="text-muted small">Register for superfast organic food delivery</p>
                </div>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3" role="alert"></div>

                <form asp-controller="Account" asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-bold text-dark">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-envelope"></i>
                            </span>
                            <input asp-for="Email" class="form-control border-start-0" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-bold text-dark">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input asp-for="Password" type="password" class="form-control border-start-0" placeholder="At least 6 characters" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label small fw-bold text-dark">Confirm Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-shield-lock"></i>
                            </span>
                            <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0" placeholder="Repeat your password" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill fw-bold mb-3">
                        Create Account
                    </button>
                </form>

                <div class="text-center mt-3 pt-3 border-top">
                    <p class="text-muted small mb-0">Already registered? <a asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="text-success fw-bold text-decoration-none">Sign In</a></p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
