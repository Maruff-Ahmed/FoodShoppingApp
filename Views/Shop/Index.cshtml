@model IEnumerable<FoodShoppingApp.Models.Product>

<h2 class="mb-4 text-center text-dark fw-bold">Food Shop</h2>

<!-- CATEGORY FILTER -->
<div class="mb-5 text-center">
    <a class="btn btn-outline-dark btn-sm mx-1 mb-2" href="/Shop/Index">All</a>
    @foreach (var cat in ViewBag.Categories)
    {
        <a class="btn btn-outline-primary btn-sm mx-1 mb-2"
           href="/Shop/Index?categoryId=@cat.Id">
            @cat.Name
        </a>
    }
</div>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-3 mb-4">
            <div class="card h-100 shadow-sm border-0 rounded-3 product-card">
                <div class="overflow-hidden rounded-top">
                    <img src="@item.ImageUrl" class="card-img-top transition-img"
                         style="height:180px; object-fit:cover;" />
                </div>

                <div class="card-body text-center">
                    <h5 class="card-title fw-bold">@item.Name</h5>
                    <p class="text-muted mb-2">@item.Category?.Name</p>
                    <p class="h6 text-danger fw-bold">৳ @item.Price</p>
                </div>

                <div class="card-footer d-flex justify-content-center gap-2 bg-white border-0">
                    <a class="btn btn-primary btn-sm rounded-pill px-3"
                       href="/Shop/Details/@item.Id">
                        View
                    </a>
                    <a class="btn btn-success btn-sm rounded-pill px-3"
                       href="/Cart/Add/@item.Id">
                        Add to Cart
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<style>
    /* Hover lift effect */
    .product-card {
        transition: transform 0.3s, box-shadow 0.3s;
    }

        .product-card:hover {
            transform: translateY(-10px) scale(1.03);
            box-shadow: 0 15px 30px rgba(0,0,0,0.2);
        }

    /* Image zoom effect */
    .transition-img {
        transition: transform 0.3s;
    }

    .product-card:hover .transition-img {
        transform: scale(1.1);
    }

    /* Category button hover */
    .btn-outline-primary:hover {
        color: #fff !important;
        background-color:black;
        border-color: black ;
    }

    /* Product title hover */
    .card-body h5:hover {
        color: black;
    }
</style>
