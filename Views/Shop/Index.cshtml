@model IEnumerable<FoodShoppingApp.Models.Product>

@{
    ViewData["Title"] = "Fresh Food & Grocery Catalog";
    int? currentCat = ViewBag.CurrentCategory as int?;
    string currentSearch = ViewBag.CurrentSearch as string ?? "";
    string currentSort = ViewBag.CurrentSort as string ?? "name";
    var categories = ViewBag.Categories as IEnumerable<FoodShoppingApp.Models.Category> ?? Enumerable.Empty<FoodShoppingApp.Models.Category>();
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item active" aria-current="page">Grocery Store</li>
            @if (currentCat.HasValue)
            {
                var activeCatName = categories.FirstOrDefault(c => c.Id == currentCat.Value)?.Name;
                if (!string.IsNullOrEmpty(activeCatName))
                {
                    <li class="breadcrumb-item active text-success fw-bold" aria-current="page">@activeCatName</li>
                }
            }
        </ol>
    </nav>

    <!-- Header Title Banner -->
    <div class="d-flex flex-wrap justify-content-between align-items-end mb-4">
        <div>
            <h1 class="display-6 fw-bold mb-1">Fresh Food & Grocery Market</h1>
            <p class="text-muted small mb-0">Browse farm-fresh organic produce, dairy, bakery, and prepared meals</p>
        </div>
        <div class="text-muted small mt-2 mt-sm-0">
            Showing <strong class="text-dark">@Model.Count()</strong> items available for fast delivery
        </div>
    </div>

    <!-- Filter & Search Toolbar -->
    <div class="card border-0 rounded-4 shadow-sm p-3 mb-4" style="background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
        <form method="get" class="row g-2 align-items-center">
            <input type="hidden" name="categoryId" value="@currentCat" />

            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="search" class="form-control bg-light border-start-0"
                           placeholder="Search fresh apples, tomatoes, milk, steak, burger..." value="@currentSearch" />
                </div>
            </div>

            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0 text-muted">
                        <i class="bi bi-sort-down"></i>
                    </span>
                    <select name="sortBy" class="form-select bg-light border-start-0" onchange="this.form.submit()">
                        <option value="name" selected="@(currentSort == "name")">Sort by: Name (A-Z)</option>
                        <option value="price_asc" selected="@(currentSort == "price_asc")">Sort by: Price (Low to High)</option>
                        <option value="price_desc" selected="@(currentSort == "price_desc")">Sort by: Price (High to Low)</option>
                    </select>
                </div>
            </div>

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 rounded-pill">
                    Filter
                </button>
                @if (!string.IsNullOrEmpty(currentSearch) || currentCat.HasValue)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill" title="Clear all filters">
                        ✕
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Category Filter Pills Strip -->
    <div class="d-flex flex-wrap gap-2 mb-4 align-items-center">
        <span class="text-muted small fw-bold me-2"><i class="bi bi-funnel"></i> Aisle:</span>
        <a asp-action="Index" asp-route-categoryId="" asp-route-search="@currentSearch" asp-route-sortBy="@currentSort"
           class="btn rounded-pill px-3 py-1 btn-sm @(!currentCat.HasValue ? "btn-dark fw-bold" : "btn-light border")">
            All Items
        </a>
        @foreach (var cat in categories)
        {
            var isSelected = currentCat == cat.Id;
            <a asp-action="Index" asp-route-categoryId="@cat.Id" asp-route-search="@currentSearch" asp-route-sortBy="@currentSort"
               class="btn rounded-pill px-3 py-1 btn-sm @(isSelected ? "btn-primary fw-bold" : "btn-light border")">
                @cat.Name
            </a>
        }
    </div>

    <!-- Products Grid -->
    @if (!Model.Any())
    {
        <div class="card border-0 rounded-4 shadow-sm text-center py-5 my-4" style="background: #FFFFFF;">
            <div class="card-body py-5">
                <div class="display-3 mb-3">🥦🔍</div>
                <h3 class="fw-bold">No grocery items found</h3>
                <p class="text-muted mb-4">We couldn't find any products matching your current search or category filter.</p>
                <a asp-action="Index" class="btn btn-primary rounded-pill px-4">
                    Clear Filters & View All
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4 mb-5">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="grocery-product-card">
                        <!-- Badges -->
                        <span class="badge-discount-tag">-20%</span>
                        <span class="badge-organic-tag">🌱 Fresh</span>

                        <!-- Product Image -->
                        <a asp-action="Details" asp-route-id="@item.Id" class="product-image-container">
                            <img src="@item.ImageUrl" alt="@item.Name" onerror="this.src='/images/tomato.svg';" />
                        </a>

                        <!-- Category -->
                        <div class="product-category-label">
                            @(item.Category?.Name ?? "Food Item")
                        </div>

                        <!-- Title -->
                        <a asp-action="Details" asp-route-id="@item.Id" class="product-title-link">
                            @item.Name
                        </a>

                        <!-- Rating -->
                        <div class="product-rating-row">
                            <span class="product-rating-stars">★★★★★</span>
                            <span class="fw-bold text-dark">4.9</span>
                            <span class="text-muted">(36)</span>
                        </div>

                        <!-- Price & Add Action -->
                        <div class="product-price-row">
                            <div>
                                <span class="product-price">৳ @item.Price.ToString("0.00")</span>
                                <span class="product-old-price">৳ @((item.Price * 1.25m).ToString("0.00"))</span>
                            </div>

                            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@item.Id" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="submit" class="btn-add-cart-circle" title="Add to Cart">
                                    <i class="bi bi-cart-plus"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
