@model IEnumerable<FoodShoppingApp.Models.Product>

@{
    ViewData["Title"] = "Food Menu & Shop";
    int? currentCat = ViewBag.CurrentCategory as int?;
    string currentSearch = ViewBag.CurrentSearch as string ?? "";
    string currentSort = ViewBag.CurrentSort as string ?? "name";
}

<div class="container py-4">
    <!-- HERO / TITLE -->
    <div class="text-center mb-4">
        <h1 class="fw-bold display-6 mb-2">Our Delicious Food Menu</h1>
        <p class="text-muted">Freshly prepared, fast delivery, and chef-crafted meals</p>
    </div>

    <!-- SEARCH & SORT BAR -->
    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-center">
                <input type="hidden" name="categoryId" value="@currentCat" />

                <div class="col-md-7">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0">🔍</span>
                        <input type="text" name="search" class="form-control border-start-0" placeholder="Search burger, pizza, fries, beverage..." value="@currentSearch" />
                    </div>
                </div>

                <div class="col-md-3">
                    <select name="sortBy" class="form-select" onchange="this.form.submit()">
                        <option value="name" selected="@(currentSort == "name")">Sort by: Name (A-Z)</option>
                        <option value="price_asc" selected="@(currentSort == "price_asc")">Sort by: Price (Low to High)</option>
                        <option value="price_desc" selected="@(currentSort == "price_desc")">Sort by: Price (High to Low)</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-1">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                    @if (!string.IsNullOrEmpty(currentSearch) || currentCat.HasValue)
                    {
                        <a asp-action="Index" class="btn btn-outline-secondary" title="Reset filters">✕</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- CATEGORY PILLS -->
    <div class="d-flex flex-wrap gap-2 justify-content-center mb-4">
        <a asp-action="Index" asp-route-categoryId="" asp-route-search="@currentSearch" asp-route-sortBy="@currentSort"
           class="btn rounded-pill px-3 py-1 @(!currentCat.HasValue ? "btn-dark" : "btn-outline-dark")">
            All Items
        </a>
        @foreach (var cat in ViewBag.Categories as IEnumerable<FoodShoppingApp.Models.Category> ?? Enumerable.Empty<FoodShoppingApp.Models.Category>())
        {
            <a asp-action="Index" asp-route-categoryId="@cat.Id" asp-route-search="@currentSearch" asp-route-sortBy="@currentSort"
               class="btn rounded-pill px-3 py-1 @(currentCat == cat.Id ? "btn-danger" : "btn-outline-secondary")">
                @cat.Name
            </a>
        }
    </div>

    <!-- PRODUCT GRID -->
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <div class="display-3 text-muted mb-3">🔍</div>
            <h4 class="fw-bold">No food items found</h4>
            <p class="text-muted">Try adjusting your search keyword or selected category filter.</p>
            <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">View All Menu Items</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden food-card">
                        <div class="position-relative">
                            <a asp-action="Details" asp-route-id="@item.Id">
                                <img src="@item.ImageUrl" class="card-img-top food-card-img" alt="@item.Name"
                                     style="height: 180px; object-fit: cover;" onerror="this.src='/favicon.ico';" />
                            </a>
                            <span class="badge bg-dark bg-opacity-75 position-absolute top-0 end-0 m-2 rounded-pill">
                                @(item.Category?.Name ?? "Menu")
                            </span>
                        </div>

                        <div class="card-body d-flex flex-column text-center p-3">
                            <h5 class="card-title fw-bold mb-1">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-dark text-decoration-none">
                                    @item.Name
                                </a>
                            </h5>
                            <p class="text-muted small text-truncate mb-2">
                                @(string.IsNullOrWhiteSpace(item.Description) ? "Fresh and delicious food item." : item.Description)
                            </p>
                            <div class="mt-auto">
                                <div class="fs-5 fw-bold text-danger mb-3">৳ @item.Price.ToString("0.00")</div>

                                <div class="d-flex gap-2 justify-content-center">
                                    <a class="btn btn-sm btn-outline-secondary rounded-pill px-3" asp-action="Details" asp-route-id="@item.Id">
                                        Details
                                    </a>

                                    <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.Id" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 fw-semibold">
                                            + Add
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
