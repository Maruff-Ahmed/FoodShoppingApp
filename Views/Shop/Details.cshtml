@model FoodShoppingApp.Models.Product

@{
    ViewData["Title"] = $"{Model.Name} - Food Menu";
    var related = ViewBag.RelatedProducts as IEnumerable<FoodShoppingApp.Models.Product> ?? Enumerable.Empty<FoodShoppingApp.Models.Product>();
}

<div class="container py-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index">Menu</a></li>
            @if (Model.Category != null)
            {
                <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@Model.CategoryId">@Model.Category.Name</a></li>
            }
            <li class="breadcrumb-item active" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden mb-5">
        <div class="row g-0">
            <!-- PRODUCT IMAGE -->
            <div class="col-md-6 p-4 d-flex align-items-center justify-content-center bg-light">
                <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded-3 shadow-sm"
                     style="max-height: 420px; width: 100%; object-fit: cover;" onerror="this.src='/favicon.ico';" />
            </div>

            <!-- PRODUCT DETAILS -->
            <div class="col-md-6 p-4 p-lg-5 d-flex flex-column justify-content-center">
                <span class="badge bg-danger rounded-pill px-3 py-2 text-uppercase mb-2" style="width: fit-content;">
                    @(Model.Category?.Name ?? "Menu Item")
                </span>

                <h1 class="fw-bold display-5 mb-2">@Model.Name</h1>

                <div class="fs-2 fw-bold text-danger mb-4">৳ @Model.Price.ToString("0.00")</div>

                <div class="mb-4">
                    <h6 class="fw-bold text-muted text-uppercase small">Description</h6>
                    <p class="fs-6 text-secondary lead mb-0">
                        @(string.IsNullOrWhiteSpace(Model.Description) ? "Prepared fresh with quality ingredients to order." : Model.Description)
                    </p>
                </div>

                <!-- ADD TO CART FORM -->
                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mt-2">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.Id" />

                    <div class="d-flex align-items-center gap-3 mb-4">
                        <label class="fw-semibold mb-0">Quantity:</label>
                        <input type="number" name="quantity" value="1" min="1" max="50" class="form-control text-center fw-bold" style="width: 100px;" />
                    </div>

                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-success btn-lg rounded-pill px-4 py-3 fw-bold flex-grow-1">
                            🛒 Add to Cart
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-pill px-4 py-3">
                            ← Menu
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- RELATED PRODUCTS -->
    @if (related.Any())
    {
        <div class="mt-5">
            <h4 class="fw-bold mb-4">You May Also Like</h4>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
                @foreach (var item in related)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden food-card">
                            <a asp-action="Details" asp-route-id="@item.Id">
                                <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name"
                                     style="height: 150px; object-fit: cover;" onerror="this.src='/favicon.ico';" />
                            </a>
                            <div class="card-body p-3 text-center">
                                <h6 class="fw-bold mb-1">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="text-dark text-decoration-none">
                                        @item.Name
                                    </a>
                                </h6>
                                <div class="text-danger fw-bold mb-2">৳ @item.Price.ToString("0.00")</div>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    View Item
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
