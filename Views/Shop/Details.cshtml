@model FoodShoppingApp.Models.Product

@{
    ViewData["Title"] = $"{Model.Name} - Urban Fresh Market";
    var related = ViewBag.RelatedProducts as IEnumerable<FoodShoppingApp.Models.Product> ?? Enumerable.Empty<FoodShoppingApp.Models.Product>();
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Shop" asp-action="Index" class="text-decoration-none">Grocery Shop</a></li>
            @if (Model.Category != null)
            {
                <li class="breadcrumb-item">
                    <a asp-controller="Shop" asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="text-decoration-none">
                        @Model.Category.Name
                    </a>
                </li>
            }
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">@Model.Name</li>
        </ol>
    </nav>

    <!-- Main Product Showcase Card -->
    <div class="card border-0 rounded-4 shadow-sm overflow-hidden mb-5" style="background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
        <div class="row g-0">
            <!-- Product Gallery / Image Column -->
            <div class="col-lg-6 p-4 p-md-5 d-flex align-items-center justify-content-center" style="background: #F8FAFC;">
                <div class="position-relative text-center w-100">
                    <span class="badge bg-success bg-opacity-15 text-success fw-bold px-3 py-2 rounded-pill position-absolute top-0 start-0">
                        🌱 100% Organic & Fresh
                    </span>
                    <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded-4 shadow-sm"
                         style="max-height: 380px; width: 100%; object-fit: contain;" onerror="this.src='/images/tomato.svg';" />
                </div>
            </div>

            <!-- Product Info & Actions Column -->
            <div class="col-lg-6 p-4 p-md-5 d-flex flex-column justify-content-center">
                <div class="mb-2">
                    <span class="badge bg-primary bg-opacity-10 text-primary fw-bold px-3 py-1 rounded-pill text-uppercase">
                        @(Model.Category?.Name ?? "Fresh Grocery")
                    </span>
                    <span class="badge bg-success bg-opacity-10 text-success fw-bold px-3 py-1 rounded-pill ms-2">
                        ● In Stock
                    </span>
                </div>

                <h1 class="display-6 fw-bold mb-2">@Model.Name</h1>

                <!-- Rating -->
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="text-warning fs-5">★★★★★</span>
                    <span class="fw-bold text-dark">4.9</span>
                    <span class="text-muted small">(84 Verified Customer Reviews)</span>
                </div>

                <!-- Price Row -->
                <div class="d-flex align-items-baseline gap-3 mb-4">
                    <span class="display-6 fw-bold text-success">৳ @Model.Price.ToString("0.00")</span>
                    <span class="fs-5 text-muted text-decoration-line-through">৳ @((Model.Price * 1.25m).ToString("0.00"))</span>
                    <span class="badge bg-warning bg-opacity-20 text-warning fw-bold px-3 py-1 rounded-pill">
                        20% OFF
                    </span>
                </div>

                <!-- Description -->
                <div class="mb-4">
                    <h6 class="fw-bold text-uppercase small text-muted mb-2">Product Description</h6>
                    <p class="text-secondary leading-relaxed mb-0">
                        @(string.IsNullOrWhiteSpace(Model.Description) ? "Harvested fresh from certified local organic farms. Carefully packaged to retain maximum freshness, vitamins, and natural crunch." : Model.Description)
                    </p>
                </div>

                <!-- Add to Cart Form -->
                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mt-2 mb-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.Id" />

                    <div class="d-flex align-items-center gap-3 mb-3">
                        <label class="fw-bold text-dark mb-0">Quantity:</label>
                        <div class="input-group" style="width: 130px;">
                            <input type="number" name="quantity" value="1" min="1" max="50" class="form-control text-center fw-bold rounded-pill" />
                        </div>
                    </div>

                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 py-3 fw-bold flex-grow-1 d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-cart-plus-fill"></i>
                            <span>Add to Cart</span>
                        </button>
                        <a asp-action="Index" class="btn btn-light border btn-lg rounded-pill px-4 py-3 text-dark fw-semibold">
                            Back
                        </a>
                    </div>
                </form>

                <!-- Value Perks Mini Grid -->
                <div class="p-3 bg-light rounded-4 border">
                    <div class="row g-2 small">
                        <div class="col-6">
                            <i class="bi bi-truck text-success me-1"></i> <strong>15-30 Mins Delivery</strong>
                        </div>
                        <div class="col-6">
                            <i class="bi bi-shield-check text-success me-1"></i> <strong>100% Quality Guaranteed</strong>
                        </div>
                        <div class="col-6">
                            <i class="bi bi-cash text-success me-1"></i> <strong>Cash on Delivery (COD)</strong>
                        </div>
                        <div class="col-6">
                            <i class="bi bi-arrow-repeat text-success me-1"></i> <strong>Easy Fresh Replacements</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    @if (related.Any())
    {
        <div class="mb-5">
            <h3 class="fw-bold mb-4">Related Fresh Items</h3>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
                @foreach (var item in related)
                {
                    <div class="col">
                        <div class="grocery-product-card">
                            <span class="badge-discount-tag">-20%</span>
                            <a asp-action="Details" asp-route-id="@item.Id" class="product-image-container">
                                <img src="@item.ImageUrl" alt="@item.Name" onerror="this.src='/images/tomato.svg';" />
                            </a>
                            <div class="product-category-label">@(item.Category?.Name ?? "Grocery")</div>
                            <a asp-action="Details" asp-route-id="@item.Id" class="product-title-link">@item.Name</a>
                            <div class="product-price-row">
                                <span class="product-price">৳ @item.Price.ToString("0.00")</span>
                                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.Id" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn-add-cart-circle" title="Add to Cart">
                                        <i class="bi bi-cart-plus"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
