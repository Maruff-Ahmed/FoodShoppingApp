@model IEnumerable<FoodShoppingApp.Models.Product>

@{
    ViewData["Title"] = "Catalog Product Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="display-6 fw-bold mb-1">🥦 Product Catalog</h1>
            <p class="text-muted small mb-0">Manage grocery inventory, prices, descriptions, and imagery</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-bold">
                <i class="bi bi-plus-lg me-1"></i> Add New Product
            </a>
            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary rounded-pill px-3">
                ← Dashboard
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4" role="alert">
            <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4" role="alert">
            <i class="bi bi-exclamation-triangle me-1"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 rounded-4 shadow-sm overflow-hidden" style="background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        <th class="ps-4 py-3" style="width: 10%;">Preview</th>
                        <th class="py-3" style="width: 28%;">Product Name</th>
                        <th class="py-3" style="width: 18%;">Category</th>
                        <th class="py-3" style="width: 14%;">Price</th>
                        <th class="py-3" style="width: 20%;">Description</th>
                        <th class="text-end pe-4 py-3" style="width: 10%;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                No products in catalog yet. Click "+ Add New Product" to populate the store.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <img src="@item.ImageUrl" alt="@item.Name"
                                         class="rounded-3 border p-1 bg-light"
                                         style="width: 52px; height: 52px; object-fit: contain;"
                                         onerror="this.src='/images/tomato.svg';" />
                                </td>
                                <td class="py-3 fw-bold text-dark">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="text-dark text-decoration-none">
                                        @item.Name
                                    </a>
                                </td>
                                <td class="py-3">
                                    <span class="badge bg-light text-dark border rounded-pill px-3 py-1">
                                        @(item.Category?.Name ?? "Uncategorized")
                                    </span>
                                </td>
                                <td class="py-3 fw-bold text-success">
                                    ৳ @item.Price.ToString("0.00")
                                </td>
                                <td class="py-3 text-muted small text-truncate" style="max-width: 220px;">
                                    @item.Description
                                </td>
                                <td class="text-end pe-4 py-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary rounded-start-pill px-3" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger rounded-end-pill px-3" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
