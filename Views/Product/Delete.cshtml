@model FoodShoppingApp.Models.Product

@{
    ViewData["Title"] = "Delete Product";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4">
                    <h3 class="fw-bold text-danger mb-3">Delete Food Item</h3>

                    @if (ViewBag.HasOrderItems == true)
                    {
                        <div class="alert alert-danger" role="alert">
                            <strong>Notice:</strong> This food item exists in past customer order records. To protect financial audit history and customer invoice integrity, it cannot be permanently deleted.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning" role="alert">
                            Are you sure you want to permanently delete this product?
                        </div>
                    }

                    <table class="table table-bordered mb-4">
                        <tr>
                            <th class="w-35 bg-light">Product Name</th>
                            <td class="fw-semibold">@Model.Name</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Category</th>
                            <td>@(Model.Category?.Name ?? "Unassigned")</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Price</th>
                            <td class="fw-bold text-danger">৳ @Model.Price.ToString("0.00")</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Image Preview</th>
                            <td>
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <img src="@Model.ImageUrl" alt="@Model.Name" class="rounded" style="max-height: 70px; object-fit: cover;" onerror="this.src='/favicon.ico';" />
                                }
                                else
                                {
                                    <span class="text-muted">No Image</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="bg-light">Description</th>
                            <td class="text-muted small">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description" : Model.Description)</td>
                        </tr>
                    </table>

                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Id" />

                        <div class="d-flex gap-2">
                            @if (ViewBag.HasOrderItems == true)
                            {
                                <button type="submit" class="btn btn-danger px-4" disabled>Delete Product</button>
                            }
                            else
                            {
                                <button type="submit" class="btn btn-danger px-4">Confirm Delete</button>
                            }
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
