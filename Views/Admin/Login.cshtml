@model FoodShoppingApp.Models.AdminLoginViewModel

@{
    ViewData["Title"] = "Admin Control Login";
}

<div class="row justify-content-center py-5">
    <div class="col-md-5 col-lg-4">
        <div class="card border-0 rounded-4 shadow-sm p-4" style="background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
            <div class="card-body p-2">
                <div class="text-center mb-4">
                    <div class="rounded-circle bg-dark text-white p-3 d-inline-flex align-items-center justify-content-center mb-2" style="width: 54px; height: 54px; font-size: 1.6rem;">
                        ⚙️
                    </div>
                    <h3 class="card-title fw-bold mb-1">Staff Access</h3>
                    <p class="text-muted small">Administration & inventory portal</p>
                </div>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small rounded-3" role="alert"></div>

                <form asp-controller="Admin" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-bold text-dark">Staff Email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-shield-lock"></i>
                            </span>
                            <input asp-for="Email" class="form-control border-start-0" placeholder="admin@foodshopping.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label small fw-bold text-dark">Staff Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-key"></i>
                            </span>
                            <input asp-for="Password" type="password" class="form-control border-start-0" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-dark btn-lg w-100 rounded-pill fw-bold mb-3">
                        Enter Admin Control
                    </button>
                </form>

                <div class="text-center mt-3 pt-3 border-top">
                    <a asp-controller="Home" asp-action="Index" class="text-muted small text-decoration-none">
                        ← Back to Customer Marketplace
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
