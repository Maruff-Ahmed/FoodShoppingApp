@model IEnumerable<FoodShoppingApp.Models.Order>

<h2>All Orders</h2>

<table class="table table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Order ID</th>
            <th>Date</th>
            <th>Total Amount</th>
            <th>Total Items</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>#@order.Id</td>
                <td>@order.OrderDate.ToString("dd MMM yyyy")</td>
                <td>৳ @order.TotalAmount</td>
                <td>@order.OrderItems.Sum(i => i.Quantity)</td>
                <td>
                    <a class="btn btn-sm btn-primary"
                       href="/Admin/Order/Details/@order.Id">
                        View
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
