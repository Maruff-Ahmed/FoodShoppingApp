@model FoodShoppingApp.Models.Discount

@{
    ViewData["Title"] = "Create Discount Code";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-body p-4">
                    <h3 class="fw-bold mb-3">Create Discount Promo Code</h3>

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Code" class="form-label fw-semibold">Discount Code</label>
                            <input asp-for="Code" class="form-control form-control-lg text-uppercase font-monospace" placeholder="e.g. SAVE20" />
                            <span asp-validation-for="Code" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Percentage" class="form-label fw-semibold">Discount Percentage (1% - 100%)</label>
                            <div class="input-group">
                                <input asp-for="Percentage" type="number" class="form-control form-control-lg" min="1" max="100" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="Percentage" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 form-check">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label fw-semibold">Active immediately</label>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary px-4">Create Code</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
