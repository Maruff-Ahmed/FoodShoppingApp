@model IEnumerable<FoodShoppingApp.Models.Discount>

@{
    ViewData["Title"] = "Discount Promo Codes";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Discount & Coupon Management</h2>
            <p class="text-muted small mb-0">Create and control promotional discount codes used at checkout</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                + Add New Discount Code
            </a>
            <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-outline-secondary ms-2">
                ← Dashboard
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3" style="width: 25%;">Promo Code</th>
                            <th class="text-center" style="width: 20%;">Discount Percentage</th>
                            <th class="text-center" style="width: 20%;">Status</th>
                            <th class="text-end pe-3" style="width: 35%;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    No discount codes found. Click "Add New Discount Code" to create one.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3">
                                        <span class="badge bg-dark fs-6 px-3 py-2 font-monospace">@item.Code</span>
                                    </td>
                                    <td class="text-center fw-bold text-success">
                                        @item.Percentage% OFF
                                    </td>
                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3">
                                        <form asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm @(item.IsActive ? "btn-outline-warning" : "btn-outline-success") me-1">
                                                @(item.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>

                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">Edit</a>

                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Delete discount code @item.Code?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
