@model FoodShoppingApp.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Admin Dashboard</h2>
            <p class="text-muted small mb-0">Overview of orders, sales, catalog, and operations</p>
        </div>
        <div>
            <form method="post" asp-controller="Admin" asp-action="Logout" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">
                    Logout
                </button>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- STATS ROW -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-body">
                    <span class="text-muted small fw-semibold text-uppercase">Total Revenue</span>
                    <h3 class="fw-bold text-success mb-1 mt-2">৳ @Model.TotalRevenue.ToString("0.00")</h3>
                    <small class="text-muted">Excluding cancelled orders</small>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-body">
                    <span class="text-muted small fw-semibold text-uppercase">Total Orders</span>
                    <h3 class="fw-bold text-dark mb-1 mt-2">@Model.TotalOrders</h3>
                    <small class="text-warning fw-semibold">@Model.PendingOrders Pending</small> •
                    <small class="text-success fw-semibold">@Model.DeliveredOrders Delivered</small>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-body">
                    <span class="text-muted small fw-semibold text-uppercase">Menu Catalog</span>
                    <h3 class="fw-bold text-primary mb-1 mt-2">@Model.TotalProducts Items</h3>
                    <small class="text-muted">Across @Model.TotalCategories Categories</small>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card shadow-sm border-0 rounded-3 h-100">
                <div class="card-body">
                    <span class="text-muted small fw-semibold text-uppercase">Active Promo Codes</span>
                    <h3 class="fw-bold text-info mb-1 mt-2">@Model.ActiveDiscounts</h3>
                    <small class="text-muted">Available for checkout</small>
                </div>
            </div>
        </div>
    </div>

    <!-- QUICK ACTIONS -->
    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-bold">Management Portals</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3 col-sm-6">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary w-100 py-3 text-start">
                        <div class="fw-bold">🍔 Manage Products</div>
                        <small class="text-muted">Add, edit, or remove food items</small>
                    </a>
                </div>
                <div class="col-md-3 col-sm-6">
                    <a asp-controller="Category" asp-action="Index" class="btn btn-outline-success w-100 py-3 text-start">
                        <div class="fw-bold">📁 Manage Categories</div>
                        <small class="text-muted">Organize menu classifications</small>
                    </a>
                </div>
                <div class="col-md-3 col-sm-6">
                    <a href="/Admin/Order/Index" class="btn btn-outline-warning w-100 py-3 text-start text-dark">
                        <div class="fw-bold">📦 Manage Orders</div>
                        <small class="text-muted">Track status & customer invoices</small>
                    </a>
                </div>
                <div class="col-md-3 col-sm-6">
                    <a href="/Admin/Discount/Index" class="btn btn-outline-info w-100 py-3 text-start text-dark">
                        <div class="fw-bold">🏷️ Manage Discounts</div>
                        <small class="text-muted">Set percentage coupons</small>
                    </a>
                </div>
            </div>

            <div class="mt-3 pt-3 border-top text-end">
                <a asp-controller="Admin" asp-action="Register" class="btn btn-sm btn-outline-dark">
                    + Register Additional Administrator
                </a>
            </div>
        </div>
    </div>

    <!-- RECENT ORDERS -->
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">Recent Customer Orders</h5>
            <a href="/Admin/Order/Index" class="btn btn-sm btn-link text-decoration-none">View All Orders →</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Order ID</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th class="text-end pe-3">Total Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentOrders.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-3 text-muted">
                                    No orders recorded yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var order in Model.RecentOrders)
                            {
                                var badgeClass = order.Status switch
                                {
                                    "Pending" => "bg-warning text-dark",
                                    "Processing" => "bg-info text-dark",
                                    "Delivered" => "bg-success text-white",
                                    "Cancelled" => "bg-danger text-white",
                                    _ => "bg-secondary text-white"
                                };

                                <tr>
                                    <td class="ps-3 fw-bold">
                                        <a href="/Admin/Order/Details/@order.Id" class="text-decoration-none">#@order.Id</a>
                                    </td>
                                    <td>@(order.User?.Email ?? order.UserId)</td>
                                    <td class="text-muted small">@order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                    <td>
                                        <span class="badge @badgeClass">@order.Status</span>
                                    </td>
                                    <td class="text-end pe-3 fw-bold text-danger">৳ @order.TotalAmount.ToString("0.00")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
