@model FoodShoppingApp.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Operations Dashboard";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="display-6 fw-bold mb-1">⚙️ Admin Dashboard</h1>
            <p class="text-muted small mb-0">Real-time overview of grocery sales, catalog stock, and fulfillment</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-shop me-1"></i> View Storefront
            </a>
            <form method="post" asp-controller="Admin" asp-action="Logout" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger rounded-pill px-3">
                    <i class="bi bi-box-arrow-right me-1"></i> Sign Out
                </button>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4" role="alert">
            <i class="bi bi-check-circle me-1"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- KPI STATS CARDS -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 rounded-4 shadow-sm h-100 p-3" style="background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-bold text-uppercase">Total Revenue</span>
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-2 fs-5">
                        <i class="bi bi-currency-dollar"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-success mb-1">৳ @Model.TotalRevenue.ToString("0.00")</h3>
                <small class="text-muted">Net delivered sales</small>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 rounded-4 shadow-sm h-100 p-3" style="background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-bold text-uppercase">Total Orders</span>
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 fs-5">
                        <i class="bi bi-bag-check"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-1">@Model.TotalOrders</h3>
                <small class="text-warning fw-bold">@Model.PendingOrders Pending</small> •
                <small class="text-success fw-bold">@Model.DeliveredOrders Delivered</small>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 rounded-4 shadow-sm h-100 p-3" style="background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-bold text-uppercase">Catalog Items</span>
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-2 fs-5">
                        <i class="bi bi-grid-3x3-gap"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-1">@Model.TotalProducts Items</h3>
                <small class="text-muted">Across @Model.TotalCategories Aisles</small>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 rounded-4 shadow-sm h-100 p-3" style="background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-bold text-uppercase">Active Discounts</span>
                    <div class="rounded-circle bg-info bg-opacity-10 text-info p-2 fs-5">
                        <i class="bi bi-tags"></i>
                    </div>
                </div>
                <h3 class="fw-bold text-dark mb-1">@Model.ActiveDiscounts Codes</h3>
                <small class="text-success fw-bold">Active for shoppers</small>
            </div>
        </div>
    </div>

    <!-- MANAGEMENT HUBS -->
    <div class="card border-0 rounded-4 shadow-sm mb-4" style="background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
        <div class="card-header bg-white py-3 border-bottom">
            <h5 class="mb-0 fw-bold">Store Management Portals</h5>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-3 col-sm-6">
                    <a asp-controller="Product" asp-action="Index" class="card border h-100 p-3 text-decoration-none rounded-3 shadow-none hover-card">
                        <div class="fs-3 mb-2">🥦</div>
                        <h6 class="fw-bold text-dark mb-1">Manage Catalog</h6>
                        <small class="text-muted">Add, edit, or adjust food prices</small>
                    </a>
                </div>
                <div class="col-md-3 col-sm-6">
                    <a asp-controller="Category" asp-action="Index" class="card border h-100 p-3 text-decoration-none rounded-3 shadow-none hover-card">
                        <div class="fs-3 mb-2">📁</div>
                        <h6 class="fw-bold text-dark mb-1">Manage Categories</h6>
                        <small class="text-muted">Organize aisles & food groups</small>
                    </a>
                </div>
                <div class="col-md-3 col-sm-6">
                    <a href="/Admin/Order/Index" class="card border h-100 p-3 text-decoration-none rounded-3 shadow-none hover-card">
                        <div class="fs-3 mb-2">📦</div>
                        <h6 class="fw-bold text-dark mb-1">Fulfill Orders</h6>
                        <small class="text-muted">Update status & print customer receipts</small>
                    </a>
                </div>
                <div class="col-md-3 col-sm-6">
                    <a href="/Admin/Discount/Index" class="card border h-100 p-3 text-decoration-none rounded-3 shadow-none hover-card">
                        <div class="fs-3 mb-2">🏷️</div>
                        <h6 class="fw-bold text-dark mb-1">Manage Coupons</h6>
                        <small class="text-muted">Create % discount promotional codes</small>
                    </a>
                </div>
            </div>

            <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                <small class="text-muted">Administrator account: <strong>@(User.Identity?.Name ?? "Admin")</strong></small>
                <a asp-controller="Admin" asp-action="Register" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                    + Register Additional Staff
                </a>
            </div>
        </div>
    </div>

    <!-- RECENT CUSTOMER ORDERS -->
    <div class="card border-0 rounded-4 shadow-sm overflow-hidden" style="background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">Recent Customer Orders</h5>
            <a href="/Admin/Order/Index" class="btn btn-sm btn-link text-success text-decoration-none fw-bold">View Full Registry →</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light border-bottom">
                        <tr>
                            <th class="ps-4 py-3">Order ID</th>
                            <th class="py-3">Customer Email</th>
                            <th class="py-3">Date</th>
                            <th class="text-center py-3">Status</th>
                            <th class="text-end pe-4 py-3">Total Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentOrders.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    No customer orders placed yet.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var order in Model.RecentOrders)
                            {
                                var badgeClass = order.Status switch
                                {
                                    "Pending" => "bg-warning text-dark",
                                    "Processing" => "bg-info text-dark",
                                    "Delivered" => "bg-success text-white",
                                    "Cancelled" => "bg-danger text-white",
                                    _ => "bg-secondary text-white"
                                };

                                <tr>
                                    <td class="ps-4 py-3 fw-bold">#@order.Id</td>
                                    <td class="py-3">@(order.User?.Email ?? "Guest")</td>
                                    <td class="py-3 text-muted small">@order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</td>
                                    <td class="text-center py-3">
                                        <span class="badge @badgeClass rounded-pill px-3 py-1">@order.Status</span>
                                    </td>
                                    <td class="text-end pe-4 py-3 fw-bold text-success">
                                        ৳ @order.TotalAmount.ToString("0.00")
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
