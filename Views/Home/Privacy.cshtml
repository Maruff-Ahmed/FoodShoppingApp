@{
    ViewData["Title"] = "Privacy & Freshness Guarantee Policy";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 rounded-4 shadow-sm p-4 p-md-5" style="background: #FFFFFF; border: 1px solid #E2E8F0 !important;">
                <div class="d-flex align-items-center gap-3 mb-4">
                    <div class="brand-logo-icon" style="width: 48px; height: 48px; font-size: 1.5rem;">
                        🥬
                    </div>
                    <div>
                        <h2 class="fw-bold mb-0">Privacy & Service Policy</h2>
                        <small class="text-muted">Last Updated: October 2026 • Urban Fresh Market • Helpline: 01888929292</small>
                    </div>
                </div>

                <div class="mb-4">
                    <h5 class="fw-bold text-dark">1. Commitment to Customer Privacy</h5>
                    <p class="text-secondary leading-relaxed">
                        At Urban Fresh Market, we value your trust. We collect only essential order delivery coordinates, email addresses, and contact numbers strictly for processing food fulfillment and delivery notifications. We never sell or share customer data with third parties.
                    </p>
                </div>

                <div class="mb-4">
                    <h5 class="fw-bold text-dark">2. 100% Freshness & Replacement Guarantee</h5>
                    <p class="text-secondary leading-relaxed">
                        Every batch of vegetables, fruits, dairy, and artisanal bread is inspected by our quality assurance team prior to packing. In the rare event an item does not meet your freshness expectations, notify us upon delivery for immediate cash replacement or refund.
                    </p>
                </div>

                <div class="mb-4">
                    <h5 class="fw-bold text-dark">3. Cash On Delivery (COD) Safeguards</h5>
                    <p class="text-secondary leading-relaxed">
                        To guarantee peace of mind, all purchases utilize Cash On Delivery. You have the right to inspect your grocery package before completing payment to the courier.
                    </p>
                </div>

                <div class="pt-3 border-top">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-bold">
                        ← Back to Grocery Storefront
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
